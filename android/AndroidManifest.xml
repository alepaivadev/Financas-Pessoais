<?xml version="1.0" encoding="utf-8"?>
<!-- Sem permissão de INTERNET: o Android impede o app de enviar dados para fora do aparelho. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.financas.pessoais"
    android:versionCode="16"
    android:versionName="2.5">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- Só para enxergar o reconhecedor de voz do aparelho; não é permissão. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro por voz aberto pelo widget, em tarefa própria: não traz o app inteiro para a frente. -->
        <activity
            android:name=".VoiceActivity"
            android:theme="@style/VoiceTheme"
            android:exported="false"
            android:taskAffinity="br.financas.pessoais.voz"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".VoiceWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>
    </application>
</manifest>
